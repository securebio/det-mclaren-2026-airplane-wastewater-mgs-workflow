/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/
/*********************************************
| CONFIGURATION FILE FOR DOWNSTREAM WORKFLOW |
*********************************************/

params {
    mode = "downstream"

    // Sequencing platform
    platform = "PLATFORM" // One of "illumina", "pacbio", "aviti"; for "ont", instead start with downstream_ont.config

    // Directories
    base_dir = "PATH_TO_BASE_DIRECTORY" // Parent for working and output directories (can be S3)
    ref_dir = "PATH_TO_REFERENCE_DIRECTORY" // Reference/index directory (generated by index workflow)

    // Files
    input_file = "${launchDir}/input.csv"

    // Other required parameters
    sim_dup_max_error_frac = 0.02 // Mismatches allowed per mate when marking similarity duplicates, as a fraction of the mates' overlap (rounded down); short-read only

    // Sentinel file settings
    // sentinel_max_wait_mins = 32 // Max minutes to wait for output files to be published before writing sentinel

    // AWS Batch job queue
    queue = "BATCH_QUEUE_NAME"
}

process.queue = params.queue
includeConfig "${projectDir}/configs/logging_downstream.config"
includeConfig "${projectDir}/configs/containers.config"
includeConfig "${projectDir}/configs/resources.config"
includeConfig "${projectDir}/configs/profiles.config"
includeConfig "${projectDir}/configs/output.config"
