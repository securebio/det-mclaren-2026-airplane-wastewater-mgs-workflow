// Specify containers for workflow processes
// For Seqera containers, see containers/ directory for build details,
// and rebuild with bin/build_wave_containers.py

// Default rust tools version. This must be defined before use in the process block below,
// so be careful if you move it elsewhere in the stacked config files.
params {
    // A tag in this fork's rust-tools repository (see the rust_tools label below). Use the
    // RUST_TOOLS_VERSION env var if set, otherwise this fork's published image
    rust_tools_version = System.getenv("RUST_TOOLS_VERSION") ?: "5a5682349a7faf76"
}

process {
    withLabel: BBTools {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/bbtools:521cc8008c749c48"
    }
    withLabel: biopython {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/biopython:1f9b81f173ab7358"
    }
    withLabel: BLAST {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/blast:b7be9dc397b73870"
    }
    withLabel: bowtie2_samtools {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/bowtie2_samtools:7d17a28088d75942"
    }
    withLabel: bracken_plus_utils {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/bracken_plus_utils:2747e4b7dd0303e0"
    }
    withLabel: coreutils {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/coreutils:6f1b16cd645a69b1"
    }
    withLabel: coreutils_file {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/coreutils_file:d073817f3408720d"
    }
    withLabel: coreutils_gzip_gawk {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/coreutils_gzip_gawk:78de0679798d6fb7"
    }
    withLabel: curl {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/curl:b44d0200efd601bb"
    }
    withLabel: fastp {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/fastp:f88318ccff4cec1c"
    }
    withLabel: FASTQC {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/fastqc:29dc7c62710fe45e"
    }
    withLabel: filtlong {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/filtlong:dc76f18453f98b9f"
    }
    // Unlike the ECR images, this is a Seqera Containers build of containers/kraken2.yml
    // (`wave --conda-file containers/kraken2.yml --freeze --platform linux/amd64`; build
    // bd-6240770eb83cde83_1; digest
    // sha256:47e7eba107403bd46a1243d12ddcc34286ad049eb2cac58b9ee6662044c6116c), pinned by its
    // frozen tag: Wave rejects digest references when Fusion is enabled, since it then adds
    // layers to the image. containers/kraken2.yml notes the kraken2 version requirement; if
    // bin/build_ecr_containers.py replaces this with an ECR build, drop this comment.
    withLabel: Kraken2 {
        container = "community.wave.seqera.io/library/kraken2:6240770eb83cde83"
    }
    withLabel: minimap2_samtools {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/minimap2_samtools:a581ba62a5d534c0"
    }
    withLabel: MultiQC {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/multiqc:108fdac314ab447e"
    }
    withLabel: ncbi_datasets {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/ncbi_datasets:a92a8b499d0db919"
    }
    withLabel: pandas {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/pandas:91e85c3fd8e9026c"
    }
    withLabel: pysam_biopython {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/pysam_biopython:eff54717b46a6c95"
    }
    withLabel: python {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/python:e7c8524f75c0f132"
    }
    withLabel: rpkg {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/rpkg:1ae221a51dce3048"
    }
    withLabel: seqkit {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/seqkit:06d4aaa75376a720"
    }
    withLabel: seqtk {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/seqtk:f74b673f63e5721d"
    }
    // Unlike the ECR images, this is a Seqera Containers build of containers/sortmerna.yml
    // (digest sha256:37c27f46c627ef0601a8685722bda44dcae8f205985edec5bfefc7f315ab9ef0),
    // pinned by its frozen tag: Wave rejects digest references when Fusion is enabled,
    // since it then adds layers to the image. The SortMeRNA index is tied to the SortMeRNA version and is built
    // with this image (bin/build_sortmerna_index.sh); if bin/build_ecr_containers.py
    // replaces it, check the version still matches the index.
    withLabel: sortmerna {
        container = "community.wave.seqera.io/library/sortmerna_pigz:e94cf69b1760a0d0"
    }
    withLabel: tar_wget {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/tar_wget:077e240847fc25c7"
    }
    withLabel: tidyverse {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/tidyverse:73aca2858ae32f35"
    }
    withLabel: unzip {
        container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/unzip:e21b02e2bc67a84c"
    }
    // This fork's build of docker/nao-rust-tools.Dockerfile, not upstream's rust-tools image,
    // which lacks the fork's duplicate-marking changes. The default tag is the first 16 hex
    // digits of `git rev-parse HEAD:rust-tools HEAD:docker/nao-rust-tools.Dockerfile | sha256sum`
    // at the commit it was built from
    // (digest sha256:0e066a1a1bfebd1e26df15f6ad26a634889529f5d194a084121cf8e21c33bd77),
    // pinned by tag since Wave rejects digest references when Fusion is enabled.
    withLabel: rust_tools {
        container = "public.ecr.aws/q0n1c7g8/det-mclaren-2026-airplane-wastewater-mgs-workflow/rust-tools:${params.rust_tools_version}"
    }
}
