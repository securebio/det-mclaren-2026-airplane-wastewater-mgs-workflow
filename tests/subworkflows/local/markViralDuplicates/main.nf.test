nextflow_workflow {

    name "Test workflow MARK_VIRAL_DUPLICATES"
    script "subworkflows/local/markViralDuplicates/main.nf"
    workflow "MARK_VIRAL_DUPLICATES"
    config "tests/configs/run.config"
    tag "subworkflow"
    tag "downstream"
    tag "mark_viral_duplicates"

    test("Should mark similarity duplicates among all reads") {
        tag "expect_success"
        when {
            workflow {
                '''
                input[0] = Channel.of(["tt1", "${projectDir}/test-data/markViralDuplicates/tt1_groups.tsv.gz"])
                    | mix(Channel.of(["tt2", "${projectDir}/test-data/markViralDuplicates/tt2_groups.tsv.gz"]))
                input[1] = 0.02
                '''
            }
        }
        then {
            // Should run without failures
            assert workflow.success
            // Output should keep every read, sorted by read ID, with the marking columns added
            def tab_in = path(workflow.out.test_in[0][1]).csv(sep: "\t", decompress: true)
            def tab_sim = path(workflow.out.hits[0][1]).csv(sep: "\t", decompress: true)
            assert tab_sim.rowCount == tab_in.rowCount
            assert tab_sim.columnNames == tab_in.columnNames + ["prim_align_dup_exemplar", "sim_dup_exemplar", "sim_dup_group_size"]
            assert tab_sim.columns["seq_id"] == tab_in.columns["seq_id"].toSorted()
            // Without alignment marking, every read is its own alignment exemplar
            assert tab_sim.columns["prim_align_dup_exemplar"] == tab_sim.columns["seq_id"]
            // Exemplars are real reads, and their group sizes sum to the read count
            def exemplars = tab_sim.columns["sim_dup_exemplar"].toSet()
            assert tab_sim.columns["seq_id"].toSet().containsAll(exemplars)
            def sizes = tab_sim.rows.findAll { r -> r["seq_id"] == r["sim_dup_exemplar"] }
                .collect { r -> r["sim_dup_group_size"] as int }
            assert sizes.sum() == tab_sim.rowCount
        }
    }

}
